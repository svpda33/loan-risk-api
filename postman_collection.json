{
  "info": {
    "name": "Loan Decision Support API",
    "description": "Separate Stage 1 historical proxy and Stage 2 funded-loan risk research predictions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"}
  ],
  "item": [
    {
      "name": "Health check",
      "request": {"method": "GET", "url": "{{baseUrl}}/health"}
    },
    {
      "name": "Stage 1 - historical acceptance proxy",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"loan_amount\": 15000,\n  \"dti_percent\": 18,\n  \"employment_length\": \"10+ years\",\n  \"state\": \"CA\"\n}"},
        "url": "{{baseUrl}}/predict/stage1"
      }
    },
    {
      "name": "Stage 2 - repayment risk",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"loan_amnt\": 15000,\n  \"int_rate\": 13.5,\n  \"annual_inc\": 72000,\n  \"dti\": 18,\n  \"delinq_2yrs\": 0,\n  \"fico_range_low\": 690,\n  \"inq_last_6mths\": 1,\n  \"open_acc\": 12,\n  \"pub_rec\": 0,\n  \"revol_bal\": 8500,\n  \"revol_util\": 42,\n  \"total_acc\": 25,\n  \"installment\": 510,\n  \"credit_age_years\": 12,\n  \"mort_acc\": 1,\n  \"total_rev_hi_lim\": 20000,\n  \"term\": \"36 months\",\n  \"emp_length\": \"10+ years\",\n  \"home_ownership\": \"MORTGAGE\",\n  \"verification_status\": \"Verified\",\n  \"purpose\": \"debt_consolidation\",\n  \"addr_state\": \"CA\",\n  \"application_type\": \"Individual\",\n  \"sub_grade\": \"C2\"\n}"},
        "url": "{{baseUrl}}/predict/stage2"
      }
    }
  ]
}
